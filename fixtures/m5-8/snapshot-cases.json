    { "id": "S08-missing-attribution", "expected": "fail", "error_includes": "requires license and attribution", "mutations": [{ "path": "systems.0.license.attribution", "delete": true }] },
    { "id": "S09-upstream-change-not-stale", "expected": "fail", "error_includes": "changed upstream must be stale", "mutations": [{ "path": "systems.0.snapshot_state", "value": "current" }, { "path": "systems.0.raw_preservation", "value": "content_repository" }, { "path": "systems.0.observed_upstream_revision", "value": "1111111111111111111111111111111111111111" }] },
    { "id": "S10-openstax-ingestion", "expected": "fail", "error_includes": "OpenStax remains link/paraphrase only", "mutations": [{ "path": "linked_sources.0.ingestion_allowed", "value": true }] }
  ]
