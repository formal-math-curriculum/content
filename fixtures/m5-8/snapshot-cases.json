    { "id": "S03-msc-current-without-digest", "expected": "fail", "error_includes": "current snapshot requires exact raw bytes and SHA-256", "mutations": [{ "path": "systems.1.snapshot_state", "value": "current" }] },
    { "id": "S04-malformed-observed-digest", "expected": "fail", "error_includes": "observed payload digest is invalid", "mutations": [{ "path": "systems.2.upstream.sha256", "value": "not-a-digest" }] },
    { "id": "S05-synthetic-public-coverage", "expected": "fail", "error_includes": "synthetic fixture cannot establish public coverage", "mutations": [{ "path": "systems.0.synthetic_fixture", "value": true }, { "path": "systems.0.public_projection_eligible", "value": true }] },
