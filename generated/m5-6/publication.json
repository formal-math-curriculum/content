      "blocks": [
        {
          "block_id": "nat-monoid-laws",
          "title": "Identity, association, commutation, and cancellation",
          "rendered": "For natural numbers, zero is the additive identity, one is the multiplicative identity, addition and multiplication associate and commute, and an equal common addend can be cancelled.",
          "latex": "a+0=a,\\quad a+b=b+a,\\quad (a+b)+c=a+(b+c),\\quad a+c=b+c\\Rightarrow a=b,\\quad a\\cdot1=a,\\quad a\\cdot b=b\\cdot a.",
          "formal_binding": {
            "fart_id": "FART-P2-000004",
            "floc_id": "FLOC-P2-000005",
            "flink_id": "FLINK-P2-000004",
            "lean_state": "scoped"
          },
          "lean": {
            "source": "#check Nat.instAddCancelCommMonoid\\n#check Nat.instCommMonoid",
            "module": "Mathlib.Algebra.Group.Nat.Defs",
            "declarations": [
              "Nat.instAddCancelCommMonoid",
              "Nat.instCommMonoid"
            ],
            "repository": "leanprover-community/mathlib4",
            "revision": "db584cd6d46c92f209a44c0f1c829460d327499d",
            "source_kind": "generated_probe_from_exact_locator"
          }
        },
        {
          "block_id": "nat-distributive-laws",
          "title": "Distributivity",
          "rendered": "Multiplication distributes over addition on both the left and the right.",
          "latex": "a(b+c)=ab+ac,\\qquad (a+b)c=ac+bc.",
          "formal_binding": {
            "fart_id": "FART-P2-000005",
            "floc_id": "FLOC-P2-000006",
            "flink_id": "FLINK-P2-000005",
            "lean_state": "scoped"
          },
          "lean": {
            "source": "#check Nat.instDistrib",
            "module": "Mathlib.Algebra.Ring.Nat",
            "declarations": [
              "Nat.instDistrib"
            ],
            "repository": "leanprover-community/mathlib4",
            "revision": "db584cd6d46c92f209a44c0f1c829460d327499d",
            "source_kind": "generated_probe_from_exact_locator"
          }
        }
      ]
    },
