          "title": "Subtract and multiply signed integers",
          "rendered": "Seven minus negative three is ten. Negative seven times negative four is twenty-eight.",
          "latex": "7-(-3)=10,\\qquad (-7)(-4)=28.",
          "formal_binding": {
            "fart_id": "FART-P2-000009",
            "floc_id": "FLOC-P2-000010",
            "flink_id": "FLINK-P2-000009",
            "lean_state": "scoped"
          },
          "lean": {
            "source": "public theorem seven_sub_neg_three : (7 : ℤ) - (-3) = 10 := by\\n  calc\\n    (7 : ℤ) - (-3) = 7 + 3 := Int.sub_neg 7 3\\n    _ = 10 := rfl\\n\\npublic theorem neg_seven_mul_neg_four : (-7 : ℤ) * (-4) = 28 := by\\n  calc\\n    (-7 : ℤ) * (-4) = 7 * 4 := Int.neg_mul_neg 7 4\\n    _ = 28 := rfl",
            "module": "FormalMath.Arithmetic.Examples.IntegerSignLaws",
            "declarations": [
              "FormalMath.Arithmetic.Examples.seven_sub_neg_three",
              "FormalMath.Arithmetic.Examples.neg_seven_mul_neg_four"
