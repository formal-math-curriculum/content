      "content_id": "cnt:p5m56:000004",
      "route_key": "p5m56c0004",
      "kind": "editorial_unit",
      "title": "Natural-number operation laws",
      "slug": "natural-number-operation-laws",
      "curriculum_candidate_id": "CAND-P1-000004",
      "summary": "A bounded view of natural-number identities, associativity, commutativity, distributivity, and additive cancellation.",
      "search_terms": [
        "distributive",
        "distributivity",
        "Nat.instDistrib",
        "natural number laws"
      ],
      "objectives": [
        "Read familiar computations as instances of reusable law schemas.",
        "Separate the instructional scope from the more general library structure used to verify it."
      ],
      "narrative": [
        "Addition on natural numbers has an identity, is associative and commutative, and supports cancellation. Multiplication has its own identity, is associative and commutative, and distributes over addition.",
        "The formal layer points to pinned mathlib instances. Those instances establish exact technical provenance; they do not expand this page to all of CAND-P1-000004 or turn a library import into a learner prerequisite."
      ],
      "source_refs": [
        "src:p1:curriculum-v1",
