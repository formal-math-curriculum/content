        }
      ],
      "prerequisite_disclosures": [],
      "blocks": [
        {
          "block_id": "nat-law-examples",
          "title": "Distribute seven; cancel nine",
          "rendered": "Seven times the sum four plus three equals the sum of the two products. If 9+x=9+y, cancelling the common addend gives x=y.",
          "latex": "7(4+3)=7\\cdot4+7\\cdot3,\\qquad 9+x=9+y\\Rightarrow x=y.",
          "formal_binding": {
            "fart_id": "FART-P2-000006",
            "floc_id": "FLOC-P2-000007",
            "flink_id": "FLINK-P2-000006",
            "lean_state": "scoped"
          },
          "lean": {
            "source": "public theorem seven_distributes_over_four_plus_three : 7 * (4 + 3) = 7 * 4 + 7 * 3 :=\\n  Nat.left_distrib 7 4 3\\n\\npublic theorem cancel_common_nine_addend {x y : Nat} (h : 9 + x = 9 + y) : x = y :=\\n  Nat.add_left_cancel h",
            "module": "FormalMath.Arithmetic.Examples.NaturalNumberLaws",
            "declarations": [
              "FormalMath.Arithmetic.Examples.seven_distributes_over_four_plus_three",
              "FormalMath.Arithmetic.Examples.cancel_common_nine_addend"
            ],
            "repository": "formal-math-curriculum/lean",
            "revision": "1b71481eec0973bea8f1bdbb52c72d8e28bbde89",
            "source_kind": "exact_project_source"
          }
        }
      ]
    },
    {
      "content_id": "cnt:p5m56:000006",
      "route_key": "p5m56c0006",
      "kind": "exercise",
      "title": "Distribute-and-cancel exercise",
      "slug": "distribute-and-cancel-exercise",
      "curriculum_candidate_id": "CAND-P1-000004",
      "summary": "A guided distributive-law exercise checks cancellation, full distribution, and the final natural-number value as three separate steps.",
      "search_terms": [
        "distributive",
        "distribute",
        "cancel",
        "exercise"
      ],
      "objectives": [
        "Cancel a common addend from both sides.",
        "Distribute to both addends.",
        "Verify the final value and reject a one-addend distribution error."
      ],
      "narrative": [
        "Given 9+7(4+3)=9+n, determine n. Record the cancellation equality, the distributed equality, and the final value separately.",
        "The solution is intentionally hidden by default in the learner interface. The diagnostic counterexample shows why multiplying only the first addend is wrong; one counterexample is not a proof of the general distributive law."
      ],
      "source_refs": [
        "src:p1:readiness-m1-5",
        "src:p4:release-v1",
        "src:openstax:7-3",
        "src:openstax:2-3",
        "src:lean:release"
      ],
      "maturity": {
        "editorial": "current_reviewed",
        "formal": "release_qualified_exercise",
        "publication": "candidate_not_deployed"
      },
      "locales": [
        {
          "locale": "en",
          "slug": "distribute-and-cancel-exercise",
          "translation_state": "current_reviewed",
          "source_revision": "P5-M5.6-CONTENT-v1"
        },
        {
          "locale": "pt",
          "slug": "distribute-and-cancel-exercise",
          "translation_state": "unavailable",
          "source_revision": "P5-M5.6-SLICE-FREEZE-v1"
        }
      ],
      "prerequisite_disclosures": [
        {
          "relation_id": "READY-P1-000001",
          "from_candidate_id": "CAND-P1-000003",
          "label": "Numeration, Place Value, and Number Representation",
          "scope": "positional or written arithmetic beyond small-number counting",
          "published_in_slice": false
        }
      ],
      "exercise": {
        "prompt": "Assume 9 + 7(4 + 3) = 9 + n for a natural number n. Show the cancellation step, distribute to both addends, and determine n.",
        "solution_initially_open": false,
        "checkpoints": [
          "7(4+3)=n",
          "7·4+7·3=n",
          "n=49"
        ],
        "diagnostic": "7(4+3) is not equal to 7·4+3."
      },
      "blocks": [
        {
          "block_id": "distribute-cancel-solution",
          "title": "Guided solution and diagnostic",
          "rendered": "Cancelling the common 9 gives 7(4+3)=n. Distributing gives 7·4+7·3=n. Evaluating gives n=49. The expression 7·4+3 is not equal to the original product.",
          "latex": "9+7(4+3)=9+n\\Rightarrow 7(4+3)=n\\Rightarrow 7\\cdot4+7\\cdot3=n\\Rightarrow n=49.",
          "formal_binding": {
            "fart_id": "FART-P2-000010",
            "floc_id": "FLOC-P2-000011",
            "flink_id": "FLINK-P2-000010",
            "lean_state": "exact"
          },
          "lean": {
            "source": "public theorem distribute_then_cancel_solution {n : Nat}\\n    (h : 9 + 7 * (4 + 3) = 9 + n) :\\n    7 * (4 + 3) = n ∧ 7 * 4 + 7 * 3 = n ∧ n = 49 := by\\n  have hcancel : 7 * (4 + 3) = n :=\\n    FormalMath.Arithmetic.Examples.cancel_common_nine_addend h\\n  have hdistributed : 7 * 4 + 7 * 3 = n := by\\n    calc\\n      7 * 4 + 7 * 3 = 7 * (4 + 3) :=\\n        FormalMath.Arithmetic.Examples.seven_distributes_over_four_plus_three.symm\\n      _ = n := hcancel\\n  have hanswer : n = 49 := by\\n    calc\\n      n = 7 * (4 + 3) := hcancel.symm\\n      _ = 7 * 4 + 7 * 3 :=\\n        FormalMath.Arithmetic.Examples.seven_distributes_over_four_plus_three\\n      _ = 49 := rfl\\n  exact ⟨hcancel, hdistributed, hanswer⟩\\n\\npublic theorem distribute_first_addend_only_is_wrong :\\n    7 * (4 + 3) ≠ 7 * 4 + 3 := by\\n  decide",
            "module": "FormalMath.Arithmetic.Exercises.NaturalNumberLaws",
            "declarations": [
              "FormalMath.Arithmetic.Exercises.distribute_then_cancel_solution",
              "FormalMath.Arithmetic.Exercises.distribute_first_addend_only_is_wrong"
            ],
            "repository": "formal-math-curriculum/lean",
            "revision": "02989949c176a839a733031514e7d0e6721350d1",
            "source_kind": "exact_project_source"
          }
        }
      ]
    },
