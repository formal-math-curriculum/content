          "block_id": "zero-product-iff",
          "title": "Exactly the displayed roots",
          "rendered": "The factored product is zero if and only if x=a or x=b.",
          "latex": "(x-a)(x-b)=0\\iff x=a\\lor x=b.",
          "formal_binding": {
            "fart_id": "FART-P2-000002",
            "floc_id": "FLOC-P2-000002",
            "flink_id": "FLINK-P2-000002",
            "lean_state": "exact"
          },
          "lean": {
            "source": "public theorem factoredProduct_eq_zero_iff (a b x : ℤ) :\\n    factoredProduct a b x = 0 ↔ x = a ∨ x = b := by\\n  constructor\\n  · intro h\\n    have hmul : (x - a) * (x - b) = 0 := by\\n      simpa [factoredProduct] using h\\n    rcases Int.eq_zero_or_eq_zero_of_mul_eq_zero hmul with ha | hb\\n    · exact Or.inl (Int.eq_of_sub_eq_zero ha)\\n    · exact Or.inr (Int.eq_of_sub_eq_zero hb)\\n  · intro h\\n    rcases h with rfl | rfl <;> simp [factoredProduct]",
            "module": "FormalMath.Algebra.ZeroProduct",
            "declarations": [
              "FormalMath.Algebra.factoredProduct_eq_zero_iff"
            ],
            "repository": "formal-math-curriculum/lean",
