{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://formal-math-curriculum.github.io/schemas/p5-m58-change-packet-v1.json",
  "title": "P5 M5.8 governed change packet v1",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "issue",
    "change_id",
    "exact_bases",
    "actors",
    "attribution",
    "change_families",
    "deployment_authorized"
  ],
  "properties": {
    "schema_version": { "const": "p5-m58-change-packet/v1" },
    "issue": { "type": "string", "pattern": "^MAT-[0-9]+$" },
    "change_id": { "type": "string", "minLength": 1 },
    "exact_bases": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content", "lean", "site", "mathlib"],
      "properties": {
        "content": { "$ref": "#/$defs/git_revision" },
        "lean": { "$ref": "#/$defs/git_revision" },
        "site": { "$ref": "#/$defs/git_revision" },
        "mathlib": { "$ref": "#/$defs/git_revision" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["actor_id", "roles"],
        "properties": {
          "actor_id": { "type": "string", "minLength": 1 },
          "roles": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/role" }, "uniqueItems": true }
        }
      }
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_references", "contributor_actor_ids"],
      "properties": {
        "source_references": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "contributor_actor_ids": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      }
    },
    "change_families": {
      "type": "array",
      "items": { "enum": ["editorial", "semantic_correspondence", "translation", "classification_alignment", "generated_mirror", "publication_candidate"] },
      "uniqueItems": true
    },
    "deployment_authorized": { "const": false }
  },
  "$defs": {
    "git_revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "role": {
      "enum": [
        "canonical_english_author",
        "mathematical_editorial_reviewer",
        "semantic_correspondence_reviewer",
        "translation_author",
        "translation_reviewer",
        "classification_alignment_reviewer",
        "snapshot_licensing_steward",
        "website_implementer",
        "release_coordinator",
        "release_approver"
      ]
    }
  }
}
